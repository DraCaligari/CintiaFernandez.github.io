---
type Lang = 'en' | 'es'
type LinkKey = 'home' | 'work' | 'about' | 'contact'

const { lang = 'en', active } = Astro.props as { lang?: Lang; active?: string }

const links: Array<{ key: LinkKey; href: string }> = lang === 'es'
  ? [
      { key: 'home',    href: `/es` },
      { key: 'work',    href: `/es/trabajo` },
      { key: 'about',   href: `/es/sobre-mi` },
      { key: 'contact', href: `/es/contacto` },
    ]
  : [
      { key: 'home',    href: `/` },
      { key: 'work',    href: `/work` },
      { key: 'about',   href: `/about` },
      { key: 'contact', href: `/contact` },
    ]

const labels: Record<Lang, Record<LinkKey, string>> = {
  en: { home:'home', work:'work', about:'about', contact:'contact' },
  es: { home:'inicio', work:'trabajo', about:'sobre mí', contact:'contacto' },
}
---
<nav>
  <a href={lang === 'es' ? `/es` : `/`} class="logo">CF</a>
  <div class="links">
    {links.map(l => (
      <a href={l.href} class={active === l.key ? 'active' : ''}>
        {labels[lang][l.key]}
      </a>
    ))}
  </div>
  <a href={lang === 'es' ? `/` : `/es`} class="lang-btn">
    {lang === 'es' ? 'EN' : 'ES'}
  </a>
</nav>

<style>
nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16px 28px;
  border-bottom: 1px solid #e8e5df;
  background: #faf9f7;
  position: sticky;
  top: 0;
  z-index: 10;
}
.logo { font-size: 17px; font-weight: 500; color: #1a1a1a; text-decoration: none; }
.links { display: flex; gap: 20px; }
.links a { font-size: 12px; color: #888; text-transform: uppercase; letter-spacing: 0.05em; text-decoration: none; }
.links a.active, .links a:hover { color: #D85A30; }
.lang-btn { font-size: 11px; border: 1px solid #ddd; border-radius: 20px; padding: 4px 11px; color: #888; text-decoration: none; }
.lang-btn:hover { color: #1a1a1a; border-color: #aaa; }
</style>