---
import Nav from '../../components/Nav.astro'
import { cv } from '../../data/cv'
---
<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width" />
  <title>Sobre mí — CF</title>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet" />
</head>
<body>
  <Nav active="about" lang="es" />
  <main>
    <section class="bio-row">
      <div class="avatar">CF</div>
      <div>
        <h1>{cv.name}</h1>
        <p class="bio">{cv.bio.es}</p>
      </div>
    </section>
    <hr />
    <section class="section">
      <h2>Experiencia</h2>
      {cv.experience.map(e => (
        <div class="exp-item">
          <span class="exp-date">{e.date}</span>
          <div>
            <p class="exp-role">{e.role.es}</p>
            <p class="exp-co">{e.company}</p>
            <p class="exp-desc">{e.desc.es}</p>
          </div>
        </div>
      ))}
    </section>
    <hr />
    <div class="two-col">
      <section class="section">
        <h2>Educación & Certs</h2>
        {cv.education.map(e => (
          <div class="edu-item">
            <p class="edu-title">{e.title}</p>
            <p class="edu-sub">{e.place} · {e.year}</p>
          </div>
        ))}
      </section>
      <section class="section">
        <h2>Idiomas</h2>
        {cv.languages.map(l => (
          <div class="lang-item">
            <p class="lang-name">{l.name}</p>
            <div class="bar-bg"><div class="bar-fill" style={`width:${l.level}%`}></div></div>
          </div>
        ))}
      </section>
    </div>
  </main>
</body>
</html>

<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: 'DM Sans', sans-serif; background: #faf9f7; color: #1a1a1a; }
  main { padding: 32px 28px; max-width: 900px; margin: 0 auto; }
  hr { border: none; border-top: 1px solid #e8e5df; margin: 28px 0; }
  .bio-row { display: flex; gap: 20px; align-items: flex-start; margin-bottom: 28px; }
  .avatar { width: 76px; height: 76px; border-radius: 50%; background: #ede9e0; display: flex; align-items: center; justify-content: center; font-size: 22px; font-weight: 300; color: #D85A30; flex-shrink: 0; }
  h1 { font-size: 20px; font-weight: 500; margin-bottom: 6px; }
  .bio { font-size: 13px; color: #777; line-height: 1.7; }
  .section h2 { font-size: 14px; font-weight: 500; padding-bottom: 10px; border-bottom: 1px solid #e8e5df; margin-bottom: 16px; }
  .exp-item { display: flex; gap: 16px; padding: 10px 0; border-bottom: 1px solid #e8e5df; }
  .exp-item:last-child { border: none; }
  .exp-date { width: 72px; font-size: 11px; color: #aaa; flex-shrink: 0; padding-top: 2px; }
  .exp-role { font-size: 13px; font-weight: 500; margin-bottom: 2px; }
  .exp-co { font-size: 12px; color: #D85A30; margin-bottom: 4px; }
  .exp-desc { font-size: 11px; color: #999; line-height: 1.5; }
  .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; }
  .edu-item { margin-bottom: 10px; }
  .edu-title { font-size: 12px; font-weight: 500; }
  .edu-sub { font-size: 11px; color: #aaa; }
  .lang-item { margin-bottom: 12px; }
  .lang-name { font-size: 12px; font-weight: 500; margin-bottom: 5px; }
  .bar-bg { height: 5px; border-radius: 3px; background: #eee; }
  .bar-fill { height: 5px; border-radius: 3px; background: #D85A30; }
</style>