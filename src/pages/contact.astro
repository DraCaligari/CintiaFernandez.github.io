---
import Nav from '../components/Nav.astro'
import { cv } from '../data/cv'
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width" />
  <title>Contact — CF</title>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@300;400;500&display=swap" rel="stylesheet" />
</head>
<body>
  <Nav active="contact" lang="en" />
  <main>

    <!-- LINKS DIRECTOS -->
    <section class="section">
      <h2>Get in touch</h2>
      <div class="cgrid">
        <a href={`mailto:${cv.email}`} class="ccard">
          <span class="cicon">✉</span>
          <p class="clabel">Email</p>
          <p class="cval">{cv.email}</p>
        </a>
        <a href={`tel:${cv.phone}`} class="ccard">
          <span class="cicon">✆</span>
          <p class="clabel">Phone</p>
          <p class="cval">{cv.phone}</p>
        </a>
        <a href={cv.linkedin} target="_blank" class="ccard">
          <span class="cicon">in</span>
          <p class="clabel">LinkedIn</p>
          <p class="cval">cintia-fernández-vega</p>
        </a>
      </div>
    </section>

    <hr />

    <!-- FORMULARIO -->
    <section class="section">
      <h2>Send a message</h2>
      <form id="contact-form">
        <div class="form-group">
          <label>Name</label>
          <input type="text" name="name" placeholder="Your name" required />
        </div>
        <div class="form-group">
          <label>Email</label>
          <input type="email" name="email" placeholder="your@email.com" required />
        </div>
        <div class="form-group">
          <label>Message</label>
          <textarea name="message" placeholder="Tell me about your project..." required></textarea>
        </div>
        <button type="submit">Send message</button>
        <p id="form-msg" class="form-msg"></p>
      </form>
    </section>

  </main>
</body>
</html>

<script>
  const RESEND_KEY = import.meta.env.PUBLIC_RESEND_API_KEY

  const form = document.getElementById('contact-form') as HTMLFormElement
  const msg  = document.getElementById('form-msg') as HTMLElement
  const btn  = form.querySelector('button') as HTMLButtonElement

  form.addEventListener('submit', async (e) => {
    e.preventDefault()
    const data = Object.fromEntries(new FormData(form))

    btn.disabled = true
    btn.textContent = 'Sending...'
    msg.textContent = ''

    try {
      const res = await fetch('https://api.resend.com/emails', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'Authorization': `Bearer ${RESEND_KEY}`,
        },
        body: JSON.stringify({
          from: 'Portfolio <onboarding@resend.dev>',
          to: ['cfernandezv000@gmail.com'],
          reply_to: data.email,
          subject: `New message from ${data.name}`,
          text: `Name: ${data.name}\nEmail: ${data.email}\n\nMessage:\n${data.message}`,
        }),
      })

      if (res.ok) {
        msg.textContent = '✓ Message sent! I\'ll get back to you soon.'
        msg.style.color = '#4caf50'
        form.reset()
      } else {
        msg.textContent = '✗ Something went wrong. Try emailing directly.'
        msg.style.color = '#e53935'
      }
    } catch {
      msg.textContent = '✗ Network error. Please try again.'
      msg.style.color = '#e53935'
    } finally {
      btn.disabled = false
      btn.textContent = 'Send message'
    }
  })
</script>

<style>
  * { box-sizing: border-box; margin: 0; padding: 0; }
  body { font-family: 'DM Sans', sans-serif; background: #faf9f7; color: #1a1a1a; }
  main { padding: 32px 28px; max-width: 900px; margin: 0 auto; }
  hr { border: none; border-top: 1px solid #e8e5df; margin: 28px 0; }
  .section h2 { font-size: 14px; font-weight: 500; padding-bottom: 10px; border-bottom: 1px solid #e8e5df; margin-bottom: 20px; }

  .cgrid { display: grid; grid-template-columns: repeat(3,1fr); gap: 12px; }
  .ccard { border: 1px solid #e8e5df; border-radius: 10px; padding: 16px; text-align: center; background: #fff; text-decoration: none; display: block; transition: border-color 0.2s; }
  .ccard:hover { border-color: #D85A30; }
  .cicon { font-size: 20px; color: #888; display: block; margin-bottom: 8px; }
  .clabel { font-size: 10px; text-transform: uppercase; letter-spacing: 0.07em; color: #aaa; margin-bottom: 3px; }
  .cval { font-size: 12px; font-weight: 500; color: #1a1a1a; word-break: break-all; }

  form { display: flex; flex-direction: column; gap: 14px; max-width: 500px; }
  .form-group { display: flex; flex-direction: column; gap: 5px; }
  label { font-size: 11px; color: #999; }
  input, textarea { font-family: 'DM Sans', sans-serif; font-size: 13px; padding: 8px 12px; border: 1px solid #e8e5df; border-radius: 8px; background: #fff; color: #1a1a1a; outline: none; }
  input:focus, textarea:focus { border-color: #D85A30; }
  textarea { height: 100px; resize: vertical; }
  button { font-size: 13px; padding: 10px 24px; border-radius: 30px; background: #1a1a1a; color: #fff; border: none; cursor: pointer; align-self: flex-start; }
  button:hover { background: #D85A30; }
  .form-msg { font-size: 12px; margin-top: 4px; }
</style>